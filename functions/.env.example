# Copy to `.env` (local) or `.env.<project-id>` (Firebase auto-loads per project),
# then fill in your values. Never commit the real file — only this example.

# Public origin of your site (used to lock down who can call /api/chat).
SITE_ORIGIN=https://example.com

# Optional: comma-separated extra origins allowed to call the API.
ALLOWED_ORIGINS=https://example.com,https://your-project.web.app

# Set to "true" to hard-enforce App Check (start "false" to monitor first).
APP_CHECK_ENFORCE=false

# Optional model override (defaults to claude-haiku-4-5).
# CHAT_MODEL=claude-haiku-4-5

# NOTE: the Anthropic API key is NOT set here. It is a Secret Manager secret
# named ANTHROPIC_API_KEY, bound to the function at deploy:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# For the local emulator, put it in functions/.secret.local instead:
#   ANTHROPIC_API_KEY=sk-ant-...
